# Backend environment variables.
# Copy this file to .env and fill real secrets locally. Never commit .env.

# Agent LLM provider: DeepSeek V4-Pro via OpenAI-compatible Chat Completions.
AGENT_LLM_PROVIDER=deepseek
AGENT_LLM_BASE_URL=https://api.deepseek.com
AGENT_LLM_MODEL=deepseek-v4-pro
AGENT_LLM_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
AGENT_LLM_MOCK_MODE=false
AGENT_LLM_TIMEOUT_SECONDS=60
AGENT_OUTPUT_DIR=services/agent/output

# Gateway-to-agent integration, if gateway calls this local agent service.
AGENTS_BASE_URL=http://127.0.0.1:8010
AGENTS_M2M_TOKEN=dev-m2m-secret
AGENTS_REGISTRY_PATH=

# Gateway / Feishu placeholders.
GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:8000
PUBLIC_WEB_BASE_URL=http://127.0.0.1:5173
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
LARK_APP_ID=
LARK_APP_SECRET=
LARK_EVENT_ENCRYPT_KEY=
LARK_VERIFICATION_TOKEN=
LARK_BASE_URL=https://open.feishu.cn
ARTIFACTS_DRIVE_FOLDER_TOKEN=
DEV_SKIP_LARK=false
LARK_CLI_PATH=lark-cli
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
