PYTHONPATH=src
STORE_BACKEND=memory
SUMMARY_CLIENT_MODE=stub
TEAMMATE_SUMMARY_BASE_URL=http://127.0.0.1:9000
TEAMMATE_SUMMARY_API_KEY=
TEAMMATE_SUMMARY_TIMEOUT_SECONDS=8
SUMMARY_IMPORTANCE_THRESHOLD=0.45

IMPORTANCE_BACKEND=hybrid
IMPORTANCE_BERT_MODEL_PATH=models/importance_bert
IMPORTANCE_BERT_BASE_MODEL=hfl/chinese-macbert-base
IMPORTANCE_BERT_DEVICE=auto
IMPORTANCE_HYBRID_BERT_WEIGHT=0.6
IMPORTANCE_MAX_LENGTH=128

TOPIC_BACKEND=hybrid
TOPIC_EMBEDDING_MODEL_PATH=models/topic_embedding
TOPIC_EMBEDDING_BASE_MODEL=BAAI/bge-small-zh-v1.5
TOPIC_EMBEDDING_DEVICE=auto
TOPIC_EMBEDDING_ASSIGN_THRESHOLD=0.68
TOPIC_EMBEDDING_UNCERTAIN_THRESHOLD=0.58
TOPIC_EMBEDDING_MAX_LENGTH=128

REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=msl
REDIS_BUFFER_TTL_SECONDS=300
REDIS_MAX_BUFFER_MESSAGES=1000
