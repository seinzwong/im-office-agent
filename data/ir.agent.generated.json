      "events": [
        {
          "date": "Step 1",
          "title": "严格 schema",
          "body": "把 IR 的 block 类型、字段、资产引用和主题 token 固化。"
        },
        {
          "date": "Step 2",
          "title": "Agent patch",
          "body": "Agent 只输出 JSON Patch，不整份重写 IR。"
        },
        {
          "date": "Step 3",
          "title": "预览与发布",
          "body": "先生成本地预览，再由用户确认发布到飞书。"
        },
        {
          "date": "Step 4",
          "title": "双向同步",
          "body": "记录端侧 revision，必要时把人工修改合并回 IR。"
        }
      ]
    }
